GEVENT_SUPPORT=True
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=<url de la base de datos>
SECRET_KEY='<tu_secret_key>'
AZURE_ACCOUNT_NAME=tu_cuenta_de_almacenamiento
AZURE_ACCOUNT_KEY=tu_llave_de_acceso_secreta
AZURE_CONTAINER_NAME=clientes-archivos
AZURE_BLOB_PREFIX=archivos

# Subida directa navegador -> Azure Blob Storage (ver files/azure_client.py)
MAX_UPLOAD_SIZE_MB=1024
AZURE_UPLOAD_SAS_EXPIRY_MINUTES=60
AZURE_DOWNLOAD_SAS_EXPIRY_MINUTES=15
AZURE_UPLOAD_BLOCK_SIZE_MB=8
AZURE_UPLOAD_CONCURRENCY=4
AZURE_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Redis: broker/cache. Usa DBs distintas para el cache Django (0) y el
# broker/result backend de Celery (1) -- ver nota en core/settings.py.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1